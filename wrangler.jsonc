{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "malawy-open-up",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-12",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/.netlify/functions/*"]
  }
}
