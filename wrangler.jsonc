{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "malawy-open-up",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/.netlify/functions/*"
    ]
  },
  "vars": {
    "AIRTABLE_BASE_ID": "appUXdWXyTbNXBPPB",
    "VAPID_PUBLIC_KEY": "BAQzPZ87WagrcSiTwGVy9V_ll0DmS1eS4e1LJ07JphI_IMWV0dtK6D5MibHx_GiR6faChiVMFtxEwr0gfajf4BA",
    "VAPID_SUBJECT": "https://github.com/briramamonjisoa-oss/malawy-open-up"
  }
}
