{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "malawy-open-up",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/.netlify/functions/*"
    ]
  },
  "vars": {
    "AIRTABLE_BASE_ID": "appUXdWXyTbNXBPPB"
  }
}
